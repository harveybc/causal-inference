{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase1.profile_merge_result.v1",
  "title": "Complete phase-1 profile-only inventory merge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "mode", "state", "terminal_count", "completed_count",
    "unavailable_count", "plan_sha256", "inventory_sha256", "envelope",
    "result_sha256"
  ],
  "properties": {
    "schema": {"const": "phase1.profile_merge_result.v1"},
    "mode": {"const": "PROFILE_ONLY"},
    "state": {"const": "PROFILE_METRICS_COMPLETE"},
    "terminal_count": {"type": "integer", "minimum": 1},
    "completed_count": {"type": "integer", "minimum": 0},
    "unavailable_count": {"type": "integer", "minimum": 0},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope": {"type": "object"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
